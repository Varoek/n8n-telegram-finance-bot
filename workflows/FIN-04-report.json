    {
      "parameters": {
        "jsCode": "const TZ = 'Asia/Makassar', START = 26;\nconst mode = $json.mode || 'scheduled'; // 'scheduled' or 'summary'\nconst arg = String($json.arg || '').trim().toLowerCase(); // '' | 'lalu' | 'YYYY-MM'\nconst now = DateTime.now().setZone(TZ);\nlet end; // last day (the 25th) of the cycle\nif (mode === 'scheduled') { // latest cycle that has finished\n end = now.day >= START ? now.set({ day: START - 1 })\n : now.minus({ months: 1 }).set({ day: START - 1 });\n} else if (/^\\d{4}-\\d{2}$/.test(arg)) {\n end = DateTime.fromFormat(arg, 'yyyy-MM', { zone: TZ }).set({ day: START - 1 });\n} else { // current open cycle, or the one before\n end = now.day >= START ? now.plus({ months: 1 }).set({ day: START - 1 })\n : now.set({ day: START - 1 });\n if (arg === 'lalu') end = end.minus({ months: 1 });\n}\nend = end.startOf('day');\nconst start = end.minus({ months: 1 }).plus({ days: 1 }); // the 26th of the previous month\nconst prevEnd = start.minus({ days: 1 });\nconst prevStart = prevEnd.minus({ months: 1 }).plus({ days: 1 });\nconst upTo = now.startOf('day') < end ? now.startOf('day') : end;\nreturn [{ json: { ...$json, mode, cycle_id: end.toFormat('yyyy-MM'),\n start: start.toISODate(), end: end.toISODate(),\n prev_start: prevStart.toISODate(), prev_end: prevEnd.toISODate(),\n is_open: end > now.startOf('day'),\n days_elapsed: Math.max(1, Math.floor(upTo.diff(start, 'days').days) + 1) } }];"
      },
