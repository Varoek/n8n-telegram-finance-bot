      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const a = $('Aggregate').first().json;\nconst r = $json;\nconst esc = s => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst rp = n => 'Rp ' + Math.round(Number(n)).toLocaleString('id-ID');\nconst note = (r.content || []).filter(b => b.type === 'text').map(b => b.text).join('').trim();\nconst delta = (v, p) => {\n if (!p) return 'baru';\n const x = Math.round((v - p) / p * 100);\n return (x >= 0 ? '+' : '') + x + '%';\n  };\nconst L = [];\nL.push(`<b>Laporan keuangan ${a.start} s/d ${a.end}</b>` + (a.open ? ' (berjalan)' : ''));\nL.push(`Pengeluaran: <b>${rp(a.expense)}</b> (${delta(a.expense, a.prev_expense)} vs siklus lalu)`);\nL.push(`Pemasukan: ${rp(a.income)} | Selisih: ${rp(a.net)}`);\nL.push(`Rata-rata per hari: ${rp(a.per_day)} | ${a.n} transaksi\\n`);\nL.push('<b>Per kategori</b>');\na.by_cat.forEach(c => L.push(`- ${esc(c.cat)}: ${rp(c.v)} (${c.pct}%, ${delta(c.v, c.prev)})`));\nL.push('\\n<b>Per orang</b>');\na.by_who.forEach(([w, v]) => L.push(`- ${esc(w)}: ${rp(v)}`));\nL.push('\\n<b>5 terbesar</b>');\na.top5.forEach(t => L.push(`- ${t.date} ${rp(t.amount)} ${esc(t.merchant)} [${esc(t.cat)}]`\n + ` <code>${t.id}</code>`));\nif (note) L.push('\\n' + esc(note));\nreturn [{ json: { text: L.join('\\n') } }];"
      },
