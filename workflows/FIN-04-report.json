        "jsonOutput": "{\n \"allowed_user_ids\": [111111111, 222222222],\n \"group_chat_id\": -1001234567890,\n \"admin_chat_id\": 111111111,\n \"spreadsheet_id\": \"YOUR_SPREADSHEET_ID\",\n \"model_default\": \"claude-haiku-5-5\",\n \"model_fallback\": \"claude-sonnet-5-5\",\n \"categories\": [\"Makanan & Minuman\", \"Belanja Harian\", \"Transport\", \"Tagihan & Utilitas\",\n \"Rumah Tangga\", \"Kesehatan\", \"Pendidikan\", \"Hiburan\", \"Keluarga & Sosial\",\n \"Cicilan & Hutang\", \"Tabungan & Investasi\", \"Pendapatan\", \"Lainnya\"]\n}",
