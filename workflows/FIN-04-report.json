    {
      "parameters": {
        "jsCode": "const c = $('Cycle').first().json;\nconst rows = $input.all().map(i => i.json).filter(r => r.status === 'ok' && r.txn_date);\nconst within = (r, s, e) => r.txn_date >= s && r.txn_date <= e; // ISO strings compare correctly\nconst cur = rows.filter(r => within(r, c.start, c.end));\nconst prev = rows.filter(r => within(r, c.prev_start, c.prev_end));\nconst sum = a => a.reduce((s, r) => s + Number(r.amount || 0), 0);\nconst group = (a, k) => {\n const o = {};\n  a.forEach(r => { const key = r[k] || '-'; o[key] = (o[key] || 0) + Number(r.amount || 0); });\n return Object.entries(o).sort((x, y) => y[1] - x[1]);\n};\nconst exp = cur.filter(r => r.type === 'expense');\nconst inc = cur.filter(r => r.type === 'income');\nconst pexp = prev.filter(r => r.type === 'expense');\nconst prevByCat = Object.fromEntries(group(pexp, 'category'));\nconst total = sum(exp);\nreturn [{ json: {\n cycle: c.cycle_id, start: c.start, end: c.end, open: c.is_open, n: cur.length,\n expense: total, income: sum(inc), net: sum(inc) - total, prev_expense: sum(pexp),\n per_day: Math.round(total / c.days_elapsed),\n by_cat: group(exp, 'category').map(([cat, v]) => ({\n cat, v, pct: total ? Math.round(100 * v / total) : 0, prev: prevByCat[cat] || 0 })),\n by_who: group(exp, 'who'),\n top5: [...exp].sort((a, b) => Number(b.amount) - Number(a.amount)).slice(0, 5)\n .map(r => ({ id: r.txn_id, date: r.txn_date, amount: Number(r.amount),\n merchant: r.merchant, cat: r.category }))\n} }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
