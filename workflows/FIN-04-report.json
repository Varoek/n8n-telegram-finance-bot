    {
      "parameters": {
        "jsCode": "const agg = $('Aggregate').first().json;\nconst cfg = $('Config').first().json;\nconst system = 'You are a concise household finance assistant. Write 3 to 5 short sentences in '\n + 'Indonesian. Use ONLY the numbers in the JSON. Do not compute new totals. Mention the biggest '\n + 'change versus the previous cycle, any category that looks unusually high, and one practical suggestion.';\nreturn [{ json: { body: { model: cfg.model_default, max_tokens: 500, system,\n messages: [{ role: 'user', content: JSON.stringify(agg) }] } } }];"
      },
