        "pythonCode": "const e = $('Format Error').first().json;\nconst row = $input.all().map(i => i.json).find(r => r.key === e.key);\nconst recent = row && row.last_sent && (Date.now() - new Date(row.last_sent).getTime() < 30 * 60 * 1000);\nreturn [{ json: { ...e, send: !recent } }];"
      },
