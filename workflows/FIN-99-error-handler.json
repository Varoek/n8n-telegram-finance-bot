    {
      "parameters": {
        "jsCode": "const e = $('Error Trigger').first().json;\nconst wf = e.workflow?.name || '?';\nconst node = e.execution?.lastNodeExecuted || '?';\nconst msg = String(e.execution?.error?.message || e.trigger?.error?.message || 'unknown').slice(0, 300);\nconst esc = s => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nreturn [{ json: { key: wf + '|' + node,\n text: `<b>n8n error</b>\\nWorkflow: ${esc(wf)}\\nNode: ${esc(node)}\\n${esc(msg)}\\n`\n + (e.execution?.url || '') } }];"
      },
